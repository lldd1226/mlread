{
    "redirects": [
      {
        "source": "/epub/:id",
        "destination": "https://491007.xyz/epub/:id",
        "statusCode": 302
      },
      {
        "source": "/en/*",
        "destination": "https://en.491007.xyz/:splat",
        "statusCode": 302
      },
      {
        "source": "/ru/*",
        "destination": "https://ru.491007.xyz/:splat",
        "statusCode": 302
      },
      {
        "source": "/MEGA/*",
        "destination": "https://de.491007.xyz/MEGA/:splat",
        "statusCode": 302
      },
      {
        "source": "/MEW/*",
        "destination": "https://de.491007.xyz/MEW/:splat",
        "statusCode": 302
      }
    ],
    "rewrites": [
      {
        "source": "/:splat",
        "destination": "/"
      }
    ]
}
